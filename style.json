{
  "version": 8,
  "name": "AmazonLocation-Hybrid-Global-Light-Default",
  "metadata": {
    "aws:virtual-variant": [
      {"key": "terrain", "variants": [{"id": "3d_terrain"}]}
    ],
    "version": "4.1.0-beta.1",
    "maputnik:renderer": "mlgljs"
  },
  "light": {"anchor": "viewport", "intensity": 0.3, "position": [1.5, 235, 30]},
  "sky": {
    "sky-color": "hsl(208, 90%, 72%)",
    "sky-horizon-blend": 0.2,
    "horizon-color": "hsl(0, 0%, 100%)",
    "horizon-fog-blend": 0.9,
    "fog-color": "hsla(0, 0%, 100%, 0.2)",
    "fog-ground-blend": 0.8,
    "atmosphere-blend": 0.2
  },
  "projection": {"type": "globe"},
  "sources": {
    "aws": {
      "attribution": "© <a href='https://docs.aws.amazon.com/location/latest/developerguide/data-attribution.html'>AWS</a>, <a href='https://legal.here.com/en-gb/terms/general-content-supplier-terms-and-notices'>HERE</a>",
      "maxzoom": 17,
      "tiles": [
        "https://maps.geo.eu-west-1.amazonaws.com/v2/tiles/vector.basemap/{z}/{x}/{y}?key=v1.public.eyJqdGkiOiJiOTNkYjBlZi04OWUzLTQxMGUtODFhMC0zYjZjZjVmZWZmMDgifYtukap0NBaJpcrS6Vit9j03GJgK9Bn-RSu5UCe3jkdSql2kKp3IEgLPtyLssbmKUdVO11sXddjK3ZOZy8V6QG0olv0K_1tOxyMIe4DAO3IV6H4VzHWiaXlbSakGiEgFLuHBdcfLDeMotye7N6rSRxuZb0CN9ytH9VjLly6-NEBRZezO_qPQyvdTFdeZsARIpL0f9YVpxPxPVvUcAWYCk5LpaPseRCDPrY5SlCdA1ZKqUA4F9RzxSTxB73Fel_SoNDkCNaux1VposBu791-uUpDzUpr7leKckrPXrpZ2hwnFbafVxFV9vq4fLTpB5KoBksuLfGNIwAx1RLLxWuMhE4c.ZGQzZDY2OGQtMWQxMy00ZTEwLWIyZGUtOGVjYzUzMjU3OGE4"
      ],
      "type": "vector"
    },
    "awsImagery": {
      "attribution": "© <a href='https://docs.aws.amazon.com/location/latest/developerguide/data-attribution.html'>AWS</a>, <a href='https://legal.here.com/en-gb/terms/general-content-supplier-terms-and-notices'>HERE</a>",
      "maxzoom": 19,
      "tiles": [
        "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "type": "raster",
      "tileSize": 256
    },
    "inhaca_magroves": {
      "type": "geojson",
      "cluster": false,
      "data": "https://raw.githubusercontent.com/isabelahrehorsky/inhaca_island_mangroves/refs/heads/main/Inhaca_mangroves_2025.geojson"
    },
    "inhaca_label": {
      "type": "geojson",
      "cluster": false,
      "data": "https://raw.githubusercontent.com/isabelahrehorsky/inhaca_island_mangroves/refs/heads/main/Inhacatextlabel.geojson"
    },
    "mangrove_change": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/isabelahrehorsky/inhaca_island_mangroves/refs/heads/main/Inhaca_mangrove_change_1996_2020.geojson"
    },
    "maputo_bay_labels": {
      "type": "geojson",
      "data": "https://raw.githubusercontent.com/isabelahrehorsky/inhaca_island_mangroves/refs/heads/main/maputo_bay_labels.geojson?v=2"
    }
  },
  "sprite": "https://maps.geo.eu-west-1.amazonaws.com/v2/styles/4_1_0-beta_1/Hybrid/Light/Default/sprites/sprites",
  "glyphs": "https://maps.geo.eu-west-1.amazonaws.com/v2/glyphs/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "land",
      "type": "background",
      "paint": {"background-color": "#247A52", "background-opacity": 1}
    },
    {
      "id": "satellite",
      "type": "raster",
      "source": "awsImagery",
      "paint": {
        "raster-brightness-min": 0.1,
        "raster-saturation": -0.4,
        "raster-opacity": 0.8,
        "raster-contrast": 0,
        "raster-brightness-max": 0.9
      }
    },
    {
      "id": "mangrove_change_1996_2020",
      "type": "fill",
      "source": "mangrove_change",
      "paint": {
        "fill-color": [
          "match",
          ["get", "status"],
          "stable",
          "#b77fb0",
          "loss",
          "#ff8a3d",
          "gain",
          "#3fe0c5",
          "#999999"
        ],
        "fill-opacity": 0.7
      }
    },
    {
      "id": "inhaca_island_name",
      "type": "symbol",
      "source": "inhaca_label",
      "minzoom": 0,
      "maxzoom": 13,
      "layout": {
        "text-field": "Inhaca Island",
        "text-pitch-alignment": "auto",
        "text-font": ["Amazon Ember Bold, Noto Sans Bold"]
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "rgba(0, 0, 0, 0.7)",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    },
    {
      "id": "water_pier-line",
      "type": "line",
      "source": "aws",
      "source-layer": "roads",
      "minzoom": 15,
      "filter": [
        "all",
        [
          "case",
          ["==", ["get", "kind_detail"], "pier"],
          true,
          ["==", ["get", "kind_detail"], "quay"],
          true,
          ["==", ["get", "landuse_kind"], "pier"],
          true,
          ["==", ["get", "landuse_kind"], "quay"],
          true,
          false
        ],
        ["!=", ["get", "kind"], "rail"],
        ["==", ["geometry-type"], "LineString"]
      ],
      "paint": {
        "line-color": "hsl(0, 0%, 80%)",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          15,
          2,
          17,
          7,
          20,
          50
        ]
      }
    },
    {
      "id": "water_pier-polygon",
      "type": "fill",
      "source": "aws",
      "source-layer": "landuse",
      "minzoom": 12,
      "filter": [
        "all",
        ["match", ["get", "kind"], ["bridge", "pier", "quay"], true, false],
        ["==", ["geometry-type"], "Polygon"]
      ],
      "paint": {"fill-color": "hsl(0, 0%, 80%)"}
    },
    {
      "id": "water_label-point",
      "type": "symbol",
      "source": "aws",
      "source-layer": "water",
      "minzoom": 0,
      "filter": [
        "all",
        [
          "step",
          ["zoom"],
          ["<", ["to-number", ["get", "display_class"]], 5],
          9,
          ["<", ["to-number", ["get", "display_class"]], 7],
          10,
          ["<", ["to-number", ["get", "display_class"]], 8],
          13,
          true
        ],
        [
          "match",
          ["get", "kind"],
          ["sea", "ocean", "bay", "lake", "strait", "water", "canal", "fjord"],
          true,
          false
        ],
        ["!=", ["get", "name"], "Pool"],
        ["==", ["geometry-type"], "Point"]
      ],
      "layout": {
        "symbol-sort-key": ["to-number", ["get", "display_class"]],
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Amazon Ember Regular,Noto Sans Regular"],
        "text-letter-spacing": 0.1,
        "text-line-height": 1,
        "text-max-width": 5,
        "text-padding": 40,
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 12]
      },
      "paint": {
        "text-color": "hsl(194, 65%, 70%)",
        "text-halo-blur": 0.8,
        "text-halo-color": "hsla(194, 48%, 8%, 0.7)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "water_label-line",
      "type": "symbol",
      "source": "aws",
      "source-layer": "water",
      "minzoom": 12,
      "filter": [
        "all",
        ["!", ["has", "is_tunnel"]],
        ["!", ["has", "intermittent"]],
        ["match", ["get", "kind"], ["stream", "river", "canal"], true, false],
        ["case", ["has", "name:en"], true, ["has", "name"], true, false],
        [
          "case",
          [
            "<=",
            ["length", ["coalesce", ["get", "name:en"], ["get", "name"]]],
            20
          ],
          true,
          false
        ],
        ["==", ["geometry-type"], "LineString"]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 500,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Amazon Ember Regular,Noto Sans Regular"],
        "text-letter-spacing": 0.3,
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 10, 16, 12]
      },
      "paint": {
        "text-color": "hsl(194, 65%, 70%)",
        "text-halo-blur": 0.8,
        "text-halo-color": "hsla(194, 48%, 8%, 0.7)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "road_label_service",
      "type": "symbol",
      "source": "aws",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": [
        "all",
        ["==", ["get", "kind"], "minor_road"],
        [
          "any",
          ["==", ["get", "kind_detail"], "service"],
          [
            "all",
            ["==", ["get", "kind_detail"], "residential"],
            ["==", ["get", "private"], true]
          ]
        ],
        ["!", ["has", "is_link"]],
        ["==", ["geometry-type"], "LineString"]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 700,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Amazon Ember Condensed RC Regular,Noto Sans Regular"],
        "text-max-angle": 40,
        "text-offset": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          ["literal", [0, -0.3]],
          14,
          ["literal", [0, 0.02]]
        ],
        "text-padding": 1,
        "text-pitch-alignment": "viewport",
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          15,
          8,
          18,
          14,
          22,
          20
        ]
      },
      "paint": {
        "text-color": "hsl(0, 1%, 100%)",
        "text-halo-blur": 0.75,
        "text-halo-color": "hsl(0, 0%, 21%)",
        "text-halo-width": 2
      }
    },
    {
      "id": "road_label_small",
      "type": "symbol",
      "source": "aws",
      "source-layer": "roads",
      "minzoom": 13,
      "filter": [
        "all",
        ["==", ["get", "kind"], "minor_road"],
        ["!=", ["get", "kind_detail"], "service"],
        ["!=", ["get", "private"], true],
        ["!", ["has", "is_link"]],
        ["==", ["geometry-type"], "LineString"]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 200,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Amazon Ember Condensed RC Bold,Noto Sans Bold"],
        "text-max-angle": 40,
        "text-offset": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          ["literal", [0, -0.3]],
          14,
          ["literal", [0, 0.02]]
        ],
        "text-padding": 1,
        "text-pitch-alignment": "viewport",
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          8,
          18,
          16,
          22,
          24
        ],
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "hsl(0, 1%, 100%)",
        "text-halo-blur": 0,
        "text-halo-color": "hsl(0, 0%, 21%)",
        "text-halo-width": 2
      }
    },
    {
      "id": "road_label_medium",
      "type": "symbol",
      "source": "aws",
      "source-layer": "roads",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "step",
          ["zoom"],
          [
            "match",
            ["get", "kind_detail"],
            ["primary", "secondary"],
            true,
            false
          ],
          10.25,
          [
            "match",
            ["get", "kind_detail"],
            ["primary", "secondary", "tertiary"],
            true,
            false
          ]
        ],
        ["!", ["has", "is_link"]],
        ["==", ["geometry-type"], "LineString"]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Amazon Ember Condensed RC Bold,Noto Sans Bold"],
        "text-max-angle": 40,
        "text-offset": [0, 0.05],
        "text-padding": 1,
        "text-pitch-alignment": "viewport",
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          9,
          18,
          17,
          22,
          25
        ],
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "hsl(0, 1%, 100%)",
        "text-halo-blur": 0,
        "text-halo-color": "hsl(0, 0%, 21%)",
        "text-halo-width": 1
      }
    },
    {
      "id": "road_label_large",
      "type": "symbol",
      "source": "aws",
      "source-layer": "roads",
      "minzoom": 8,
      "filter": [
        "all",
        ["match", ["get", "kind_detail"], ["motorway", "trunk"], true, false],
        ["!", ["has", "is_link"]],
        ["==", ["geometry-type"], "LineString"]
      ],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 300,
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Amazon Ember Condensed RC Bold,Noto Sans Bold"],
        "text-max-angle": 40,
        "text-offset": [0, 0.05],
        "text-padding": 1,
        "text-pitch-alignment": "viewport",
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          10,
          18,
          18,
          22,
          26
        ],
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "hsl(0, 0%, 100%)",
        "text-halo-blur": 0.75,
        "text-halo-color": "hsl(0, 0%, 21%)",
        "text-halo-width": 1.25
      }
    },
    {
      "id": "mangrove_change_outline",
      "type": "line",
      "source": "mangrove_change",
      "filter": ["!=", ["get", "status"], "stable"],
      "paint": {
        "line-color": [
          "match",
          ["get", "status"],
          "loss",
          "#ff8a3d",
          "gain",
          "#3fe0c5",
          "#999999"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          1.5,
          13,
          0.8,
          15,
          0.4
        ]
      }
    },
    {
      "id": "mangroves_extent_2025",
      "type": "fill",
      "source": "inhaca_magroves",
      "layout": {"visibility": "none"},
      "paint": {
        "fill-color": "rgba(193, 63, 174, 1)",
        "fill-opacity": 0.85,
        "fill-outline-color": "rgba(0, 0, 0, 0)"
      }
    },
    {
      "id": "maputo_bay_labels",
      "type": "symbol",
      "source": "maputo_bay_labels",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Amazon Ember Bold,Noto Sans Bold"],
        "text-size": [
          "case",
          ["==", ["get", "name"], "Maputo"],
          16,
          ["==", ["get", "kind"], "water"],
          12,
          13
        ],
        "text-letter-spacing": ["match", ["get", "kind"], "water", 0.15, 0.02]
      },
      "paint": {
        "text-color": ["match", ["get", "kind"], "water", "#a8dcff", "#ffffff"],
        "text-halo-color": "rgba(0, 0, 0, 0.7)",
        "text-halo-width": 1.5,
        "text-halo-blur": 0.5
      }
    }
  ],
  "created": "0001-01-01T00:00:00Z",
  "modified": "0001-01-01T00:00:00Z",
